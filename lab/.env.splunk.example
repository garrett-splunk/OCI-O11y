# Splunk O11y — metrics lab (template only — safe to commit).
# Real credentials go in .env.splunk (gitignored).
#
# Metrics-only lab needs Python 3 + this file — no Docker required.
#
#   cd lab
#   cp .env.splunk.example .env.splunk
#   # Edit SPLUNK_ACCESS_TOKEN and match realm/URLs to your org (e.g. us1)

SPLUNK_REALM=us0
SPLUNK_ACCESS_TOKEN=your-ingest-token-here
SPLUNK_INGEST_URL=https://ingest.us0.signalfx.com
SPLUNK_API_URL=https://api.us0.signalfx.com
